PORT=3000
DATABASE_URL=postgresql://sales:sales123@localhost:5433/sales_map
AMAP_KEY=YOUR_AMAP_KEY

# 高德路径规划请求配置
AMAP_ROUTE_TIMEOUT_MS=15000
AMAP_ROUTE_RETRY_COUNT=5

# 可选：服务器无法直连高德时，为后端请求配置代理
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# 里程读数合理上限（km），超过此值的读数会被视为异常
MILEAGE_VALIDATION_MAX_KM=5000

# 登录账号密码（临时硬编码，后续接入统一身份认证）
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123

# 钉钉开放平台（企业内部应用）
# 扫码登录（/login/callback）也复用这对 Key/Secret 作为 clientId/clientSecret，
# 需要在开放平台为该应用开通「扫码登录」能力并配置重定向 URL
DINGTALK_APP_KEY=YOUR_DINGTALK_APP_KEY
DINGTALK_APP_SECRET=YOUR_DINGTALK_APP_SECRET
DINGTALK_PROCESS_CODE=YOUR_DINGTALK_PROCESS_CODE
# 新审批表单（v2「用车里程登记&拜访客户签到」）process_code；为空则只同步旧表单。
# 旧表单停用时把 DINGTALK_PROCESS_CODE 清空即可，v1 解析代码保留用于历史重跑。
DINGTALK_PROCESS_CODE_V2=

# 钉钉扫码登录允许的前端回调 origin（逗号分隔），回调地址为 <origin>/login/callback
DINGTALK_LOGIN_ALLOWED_ORIGINS=http://localhost:5173,http://8.219.97.3:5173

# 应急密码登录通道（管理员），生产建议关闭；开启后 POST /auth/login 可用
AUTH_PASSWORD_LOGIN_ENABLED=false

# 旧的 X-User-Id 信任头回退：仅限本地开发过渡，生产必须保持 false
AUTH_HEADER_FALLBACK=false

# 定时任务总开关（风险缓存刷新/钉钉同步/报告生成/用户对账），默认 true
# 本地开发务必设为 false，避免与线上实例重复执行（如日报生成两份钉钉文档）
SCHEDULER_ENABLED=true

# 钉钉文档（知识库）导出操作人 user_id
# 需要是该企业内的真实钉钉用户，用于调用钉钉文档 API 创建文档、文件夹并授权
DINGTALK_OPERATOR_USERID=

# 可选：钉钉文档知识库名称，不填则默认为「外勤拜访报告」
DINGTALK_DOC_WORKSPACE_NAME=

# 控制台导出报告目标钉钉群 chatid（可通过钉钉 JSAPI 选择群聊获取）
DINGTALK_EXPORT_CHAT_ID=

# 可选：自定义机器人 webhook，用于发送文字摘要（不填则不发送）
DINGTALK_EXPORT_ROBOT_WEBHOOK=

# 可选：自定义机器人加签密钥（如果机器人在钉钉里开了“加签”安全设置，需要填这个）
DINGTALK_EXPORT_ROBOT_SECRET=

# 钉钉企业内部应用 AgentId，用于发送工作通知给个人
# 在钉钉开放平台 → 应用详情 → 应用信息 → AgentId 获取
DINGTALK_AGENT_ID=YOUR_DINGTALK_AGENT_ID

# 可选：日报工作通知的区总/负责人配置，格式「子部门名:姓名;部门名:姓名」，如 华南一部:李朝晖;软件产品线:洪晨备
# 姓名按 users.user_name 解析，找不到再查钉钉通讯录缓存（dingtalk_users），也可以直接配钉钉 userid。
# 某子部门/部门一旦配置即以配置为准（不再自动带 role=manager）；未配置的子部门回退为 role=manager 的用户；
# 另支持「公司:姓名」接收全公司汇总。
# 注意：该配置同时影响控制台「员工可看上级」权限——被配置的 leader 对其子部门成员可见；
# 其中 role='admin' 的 leader（如李朝晖）会从「admin 全员可见」中剔除，仅本区下属与 admin 可见
REPORT_DEPT_LEADERS=
